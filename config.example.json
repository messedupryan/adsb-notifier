{
  "adsb_url": "http://readsb.default.svc.cluster.local/tar1090/data/aircraft.json",
  "adsb_source": {
    "provider": "adsb_lol",
    "query": "point",
    "radius_miles": 40
  },
  "home": {
    "lat": 40.7608,
    "lon": -111.8910
  },
  "poll_seconds": 30,
  "stale_aircraft_seconds": 90,
  "recent_matches_window_hours": 24,
  "source_error_alerts": {
    "enabled": true,
    "failure_threshold": 3,
    "cooldown_minutes": 60
  },
  "notifications": {
    "email": {
      "enabled": false,
      "html_enabled": true,
      "smtp_host": "smtp.gmail.com",
      "smtp_port": 587,
      "starttls": true,
      "username": "env:SMTP_USERNAME",
      "password": "env:SMTP_PASSWORD",
      "from": "env:SMTP_USERNAME",
      "to": ["env:SMTP_USERNAME"],
      "brand_theme": "teal",
      "include_brand_images": true,
      "include_map_snapshot": false,
      "subject_template": "ADS-B alert: {aircraft_label} matched {rule_name}",
      "body_template": "{message}\n\nAircraft: {aircraft_label}\nRegistration: {registration}\nFlight: {flight}\nType: {aircraft_type}\nDescription: {description}\nOperator: {operator}\nAltitude: {altitude_label}\nDistance: {distance_miles:.1f} mi\nTrack: {track_label}\nSpeed: {ground_speed_label}\nVertical rate: {vertical_rate_label}\nSquawk: {squawk}\nSeen: {seen_label}\nHex: {hex}\nAirplanes.live: {airplanes_live_url}\nRule: {rule_name}\nObserved: {observed_at}",
      "html_body_template": "<p>{message_html}</p>\n\n<p>\n  <a href=\"{airplanes_live_url_html}\">Airplanes.live</a>\n</p>\n\n{map_snapshot_html}\n\n<table>\n  <tr>\n    <th align=\"left\">Aircraft</th>\n    <td>{aircraft_label_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Registration</th>\n    <td>{registration_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Flight</th>\n    <td>{flight_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Type</th>\n    <td>{aircraft_type_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Description</th>\n    <td>{description_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Operator</th>\n    <td>{operator_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Altitude</th>\n    <td>{altitude_label_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Distance</th>\n    <td>{distance_miles:.1f} mi</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Track</th>\n    <td>{track_label_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Speed</th>\n    <td>{ground_speed_label_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Vertical rate</th>\n    <td>{vertical_rate_label_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Squawk</th>\n    <td>{squawk_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Seen</th>\n    <td>{seen_label_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Hex</th>\n    <td>{hex_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Rule</th>\n    <td>{rule_name_html}</td>\n  </tr>\n  <tr>\n    <th align=\"left\">Observed</th>\n    <td>{observed_at_html}</td>\n  </tr>\n</table>"
    },
    "twilio": {
      "enabled": false,
      "account_sid": "env:TWILIO_ACCOUNT_SID",
      "api_key_sid": "env:TWILIO_API_KEY_SID",
      "api_key_secret": "env:TWILIO_API_KEY_SECRET",
      "from": "env:TWILIO_FROM",
      "to": "env:TWILIO_TO",
      "body_template": "{rule_name}: {aircraft_label} {distance_miles_1} mi away at {altitude_label}"
    },
    "pushover": {
      "enabled": false,
      "app_token": "env:PUSHOVER_APP_TOKEN",
      "user_key": "env:PUSHOVER_USER_KEY",
      "device": "",
      "priority": 0,
      "sound": "pushover",
      "title_template": "ADS-B: {aircraft_label}",
      "url_template": "{airplanes_live_url}",
      "url_title_template": "Airplanes.live",
      "message_template": "{rule_name}: {aircraft_label} ({aircraft_type}) {distance_miles_1} mi away at {altitude_label}"
    }
  },
  "rules": [
    {
      "name": "Tail number near home",
      "event": "tail",
      "tail_numbers": ["N12345"],
      "radius_miles": 25,
      "max_altitude_ft": 12000,
      "cooldown_minutes": 60
    },
    {
      "name": "Military nearby",
      "event": "military",
      "military": true,
      "radius_miles": 40,
      "max_altitude_ft": 25000,
      "cooldown_minutes": 30
    },
    {
      "name": "Helicopter nearby",
      "event": "aircraft_type",
      "aircraft_types": ["H60", "EC45"],
      "categories": ["A7"],
      "radius_miles": 15,
      "cooldown_minutes": 20
    },
    {
      "name": "Circling near home",
      "event": "circling",
      "radius_miles": 12,
      "max_altitude_ft": 10000,
      "circling_min_heading_change_deg": 270,
      "circling_window_minutes": 8,
      "cooldown_minutes": 45
    }
  ]
}
